# Application Settings
SECRET_KEY=c_v=y!##vqy(2z&-m+78af3_qzlf*@nf8$of@jun)pd1@n#hhk
DEBUG=False
ALLOWED_HOSTS=blog.mydomain.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://blog.mydomain.com
PORT=8000

# Security Settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# Database Settings (PostgreSQL or DATABASE_URL)
# DATABASE_URL=postgres://djblogger:tulisanrahasia@db:5432/blogdb
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blogdb
DB_USER=djblogger
DB_PASSWORD=tulisanrahasia
DB_CONN_MAX_AGE=600

# Redis Session & Cache Configuration (For Multi-Pod Replication)
# REDIS_URL=redis://:password@redis-host:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Observability - Prometheus & Loki Logging
DJANGO_LOG_LEVEL=INFO
# LOKI_URL=http://loki.monitoring.svc:3100/loki/api/v1/push

# Observability - OpenTelemetry Distributed Tracing
ENABLE_OTEL=False
OTEL_SERVICE_NAME=djblog
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.monitoring.svc:4318/v1/traces

# Multi-Replica Pod Settings
RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=true

# Gunicorn Performance Tuning
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50
